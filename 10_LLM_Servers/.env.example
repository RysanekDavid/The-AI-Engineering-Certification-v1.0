# Fireworks AI — get a key at https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
TAVILY_API_KEY=

# Fireworks models (defaults used if left empty/omitted)
FIREWORKS_CHAT_MODEL=accounts/fireworks/models/gpt-oss-20b
FIREWORKS_EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b

# LangSmith tracing (optional, for Activity 1 cost analysis)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Off-VPN on this laptop: Windows registry points to proxy.dclb.cpost.cz which
# does not resolve; bypass it. Remove these two lines when ON the corporate VPN.
NO_PROXY=*
no_proxy=*
